{
  "name": "nexo-fulfillment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pedidos, inventario y despachos con procesamiento as\u00edncrono y seguimiento en tiempo real.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build --workspace apps/web",
    "build:server": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace apps/web",
    "dev": "node scripts/dev.mjs",
    "start:operations": "node --env-file-if-exists=.env dist/apps/operations/src/main.js",
    "start:documents": "node --env-file-if-exists=.env dist/apps/documents/src/main.js",
    "start:notifications": "node --env-file-if-exists=.env dist/apps/notifications/src/main.js",
    "infra:bootstrap": "node --env-file-if-exists=.env dist/scripts/bootstrap-aws.js",
    "db:migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "test": "npm run build:server && node --test dist/test/unit/*.test.js",
    "test:integration": "npm run build:server && node --env-file-if-exists=.env --test --test-concurrency=1 dist/test/integration/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages scripts test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/client-secrets-manager": "3.1157.0",
    "@aws-sdk/client-sns": "3.1157.0",
    "@aws-sdk/client-sqs": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "12.3.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pdfkit": "0.17.7",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
