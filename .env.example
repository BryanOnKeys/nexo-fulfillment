NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
JWT_SECRET=
SEED_PASSWORD=
POSTGRES_PASSWORD=
PG_OPERATIONS_PASSWORD=
PG_DOCUMENTS_PASSWORD=
PG_NOTIFICATIONS_PASSWORD=
OPERATIONS_DATABASE_URL=postgresql://nexo_operations:CHANGE_ME@localhost:5432/nexo_operations
DOCUMENTS_DATABASE_URL=postgresql://nexo_documents:CHANGE_ME@localhost:5432/nexo_documents
NOTIFICATIONS_DATABASE_URL=postgresql://nexo_notifications:CHANGE_ME@localhost:5432/nexo_notifications
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:5000
S3_PUBLIC_ENDPOINT=http://localhost:5000
AWS_SECRET_ID=nexo/local
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:nexo-events
DOCUMENTS_QUEUE_URL=http://localhost:5000/123456789012/nexo-documents
NOTIFICATIONS_QUEUE_URL=http://localhost:5000/123456789012/nexo-notifications
S3_BUCKET=nexo-documents
ENABLE_WORKERS=true
OPERATIONS_PORT=3001
DOCUMENTS_PORT=3002
NOTIFICATIONS_PORT=3003
